move('dark');\r\n      localStorage.setItem('theme', 'light');\r\n    }\r\n  }, [isDark]);\r\n\r\n  const toggleTheme = () => setIsDark(!isDark);\r\n\r\n  return (\r\n    <ThemeContext.Provider value={{ isDark, toggleTheme }}>\r\n      {children}\r\n    </ThemeContext.Provider>\r\n  );\r\n}\r\n\r\nexport function useTheme() {\r\n  return useContext(ThemeContext);\r\n}"],"mappings":"AAAA,OAASA,aAAa,CAAEC,UAAU,CAAEC,SAAS,CAAEC,QAAQ,KAAQ,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,yBAEvE,KAAM,CAAAC,YAAY,cAAGN,aAAa,CAAC,CAAC,CAEpC,MAAO,SAAS,CAAAO,aAAaA,CAAAC,IAAA,CAAe,IAAd,CAAEC,QAAS,CAAC,CAAAD,IAAA,CACxC,KAAM,CAACE,MAAM,CAAEC,SAAS,CAAC,CAAGR,QAAQ,CAAC,IAAI,CAAC,CAE1CD,SAAS,CAAC,IAAM,CACd,KAAM,CAAAU,KAAK,CAAGC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,CAC3C,GAAIF,KAAK,CAAE,CACTD,SAAS,CAACC,KAAK,GAAK,MAAM,CAAC,CAC7B,CAAC,IAAM,CACLD,SAAS,CAACI,MAAM,CAACC,UAAU,CAAC,8BAA8B,CAAC,CAACC,OAAO,CAAC,CACtE,CACF,CAAC,CAAE,EAAE,CAAC,CAENf,SAAS,CAAC,IAAM,CACd,GAAIQ,MAAM,CAAE,CACVQ,QAAQ,CAACC,eAAe,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC,CAC9CR,YAAY,CAACS,OAAO,CAAC,OAAO,CAAE,MAAM,CAAC,CACvC,CAAC,IAAM,CACLJ,QAAQ,CAACC,eAAe,CAACC,SAAS,CAACG,MAAM,CAAC,MAAM,CAAC,CACjDV,YAAY,CAACS,OAAO,CAAC,OAAO,CAAE,OAAO,CAAC,CACxC,CACF,CAAC,CAAE,CAACZ,MAAM,CAAC,CAAC,CAEZ,KAAM,CAAAc,WAAW,CAAGA,CAAA,GAAMb,SAAS,CAAC,CAACD,MAAM,CAAC,CAE5C,mBACEL,IAAA,CAACC,YAAY,CAACmB,QAAQ,EAACC,KAAK,CAAE,CAAEhB,MAAM,CAAEc,WAAY,CAAE,CAAAf,QAAA,CACnDA,QAAQ,CACY,CAAC,CAE5B,CAEA,MAAO,SAAS,CAAAkB,QAAQA,CAAA,CAAG,CACzB,MAAO,CAAA1B,UAAU,CAACK,YAAY,CAAC,CACjC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}